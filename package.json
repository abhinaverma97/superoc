{
  "name": "superoc",
  "version": "0.1.20",
  "description": "Multi-provider API key & OAuth account rotator plugin for OpenCode — NVIDIA NIM, Google Gemini & Google Cloud Code Antigravity",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "superoc": "bin/superoc.js",
    "nimsuper": "bin/superoc.js"
  },
  "scripts": {
    "build": "tsc",
    "tui": "bun run bin/superoc.ts",
    "prepare": "npm run build",
    "postinstall": "node scripts/postinstall.js",
    "uninstall": "node scripts/uninstall.js",
    "format": "prettier -w ."
  },
  "keywords": [
    "opencode",
    "plugin",
    "superoc",
    "nimsuper",
    "opencode nim rotator",
    "google rotator",
    "nvidia",
    "nim",
    "google",
    "gemini",
    "antigravity",
    "claude",
    "rotation",
    "api-key"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhinaverma97/superoc.git"
  },
  "bugs": {
    "url": "https://github.com/abhinaverma97/superoc/issues"
  },
  "homepage": "https://github.com/abhinaverma97/superoc#readme",
  "author": "abhinaverma97",
  "license": "MIT",
  "files": [
    "dist",
    "bin",
    "scripts"
  ],
  "dependencies": {
    "@opencode-ai/plugin": "^1.17.11",
    "@opentui/core": "^0.4.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "prettier": "^3.8.4",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "bun": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "bun": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
